@page
@model SubtitleTranslator.Pages.Prompts.IndexModel
@{
    ViewData["Title"] = "Prompts";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Prompts</h1>
</div>
@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Create prompt template</h2>
        <form method="post" asp-page-handler="CreateTemplate" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label asp-for="NewTemplate.Name" class="form-label">Name</label>
                <input asp-for="NewTemplate.Name" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label asp-for="NewTemplate.Description" class="form-label">Description</label>
                <input asp-for="NewTemplate.Description" class="form-control" />
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">Create template</button>
            </div>
        </form>
    </div>
</div>
@foreach (var template in Model.Templates)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <strong>@template.Name</strong>
                @if (!string.IsNullOrWhiteSpace(template.Description))
                {
                    <span class="text-muted ms-2">@template.Description</span>
                }
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-primary" asp-page="CreateVersion" asp-route-templateId="@template.Id">Add version</a>
                <form method="post" asp-page-handler="DeleteTemplate" asp-route-id="@template.Id" onsubmit="return confirm('Delete this prompt template?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete template</button>
                </form>
            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Version</th>
                        <th>Name</th>
                        <th>Prompt cache</th>
                        <th>Enabled</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (template.Versions.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">No versions created for this template.</td>
                        </tr>
                    }
                    @foreach (var version in template.Versions.OrderByDescending(item => item.Version))
                    {
                        <tr>
                            <td>v@version.Version</td>
                            <td>@(string.IsNullOrWhiteSpace(version.Name) ? "—" : version.Name)</td>
                            <td>@(version.SupportsPromptCache ? $"Enabled ({version.PromptCacheKey ?? "default"})" : "Disabled")</td>
                            <td>@(version.Enabled ? "Yes" : "No")</td>
                            <td>@version.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-page="EditVersion" asp-route-id="@version.Id">Edit</a>
                                <form method="post" asp-page-handler="ToggleVersion" asp-route-id="@version.Id" class="d-inline">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">@(version.Enabled ? "Disable" : "Enable")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
