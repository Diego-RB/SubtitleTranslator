@page
@model SubtitleTranslator.Pages.Pipelines.IndexModel
@{ ViewData["Title"] = "Pipelines"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Pipelines</h1><a class="btn btn-primary" asp-page="Create">Create pipeline</a></div>
@if (Model.Message is not null) { <div class="alert alert-success">@Model.Message</div> }
@if (Model.ErrorMessage is not null) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
<table class="table table-striped align-middle"><thead><tr><th>Name</th><th>Description</th><th>Enabled</th><th>Steps</th><th>Actions</th></tr></thead><tbody>
@foreach (var pipeline in Model.Pipelines) { <tr><td>@pipeline.Name</td><td>@pipeline.Description</td><td>@(pipeline.Enabled ? "Yes" : "No")</td><td>@pipeline.Steps.Count</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@pipeline.Id">Edit</a> <a class="btn btn-sm btn-outline-info" asp-page="Steps/Index" asp-route-pipelineId="@pipeline.Id">Steps</a> <form method="post" asp-page-handler="Toggle" asp-route-id="@pipeline.Id" class="d-inline"><button class="btn btn-sm btn-outline-secondary" type="submit">@(pipeline.Enabled ? "Disable" : "Enable")</button></form> <form method="post" asp-page-handler="Delete" asp-route-id="@pipeline.Id" class="d-inline" onsubmit="return confirm('Delete this pipeline?');"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></td></tr> }
</tbody></table>
