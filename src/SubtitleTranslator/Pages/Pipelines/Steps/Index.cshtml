@page
@model SubtitleTranslator.Pages.Pipelines.Steps.IndexModel
@{ ViewData["Title"] = "Pipeline steps"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Pipeline steps</h1><p class="text-muted">@Model.Pipeline!.Name</p></div><a class="btn btn-primary" asp-page="Create" asp-route-pipelineId="@Model.Pipeline.Id">Add step</a></div>
@if (Model.Message is not null) { <div class="alert alert-success">@Model.Message</div> } @if (Model.ErrorMessage is not null) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
<table class="table table-striped"><thead><tr><th>Order</th><th>Provider</th><th>Model</th><th>Enabled</th><th>Actions</th></tr></thead><tbody>
@foreach (var step in Model.Pipeline.Steps.OrderBy(item => item.Order).ThenBy(item => item.Id)) { <tr><td>@step.Order</td><td>@step.ModelDefinition?.Provider?.Name</td><td>@step.ModelDefinition?.Name</td><td>@(step.Enabled ? "Yes" : "No")</td><td class="text-nowrap"><form method="post" asp-page-handler="MoveUp" asp-route-pipelineId="@Model.Pipeline.Id" asp-route-id="@step.Id" class="d-inline"><button class="btn btn-sm btn-outline-secondary" type="submit" title="Move up">↑</button></form> <form method="post" asp-page-handler="MoveDown" asp-route-pipelineId="@Model.Pipeline.Id" asp-route-id="@step.Id" class="d-inline"><button class="btn btn-sm btn-outline-secondary" type="submit" title="Move down">↓</button></form> <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-pipelineId="@Model.Pipeline.Id" asp-route-id="@step.Id">Edit</a> <form method="post" asp-page-handler="Toggle" asp-route-pipelineId="@Model.Pipeline.Id" asp-route-id="@step.Id" class="d-inline"><button class="btn btn-sm btn-outline-secondary" type="submit">@(step.Enabled ? "Disable" : "Enable")</button></form> <form method="post" asp-page-handler="Delete" asp-route-pipelineId="@Model.Pipeline.Id" asp-route-id="@step.Id" class="d-inline" onsubmit="return confirm('Remove this step?');"><button class="btn btn-sm btn-outline-danger" type="submit">Remove</button></form></td></tr> }
</tbody></table><a asp-page="../Index">Back to pipelines</a>
