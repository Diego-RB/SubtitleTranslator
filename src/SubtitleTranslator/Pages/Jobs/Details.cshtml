@page "{id:int}"
@model SubtitleTranslator.Pages.Jobs.DetailsModel
@using SubtitleTranslator.Domain.Enums
@{
    ViewData["Title"] = $"Job {Model.Job.Id}";
    var endAt = Model.Job.CompletedAt ?? (Model.Job.Status is JobStatus.Failed or JobStatus.Cancelled ? Model.Job.UpdatedAt
: DateTimeOffset.UtcNow);
    var elapsed = Model.Job.StartedAt is null ? (TimeSpan?)null : endAt - Model.Job.StartedAt.Value;
    var activeBatchProgress = !string.IsNullOrWhiteSpace(Model.Job.AzureBatchId)
        && Model.Job.AzureBatchTotalRequests > 0
        && Model.Job.AzureBatchStatus is not null
        && !Model.Job.AzureBatchStatus.Equals("completed", StringComparison.OrdinalIgnoreCase)
        && !Model.Job.AzureBatchStatus.Equals("failed", StringComparison.OrdinalIgnoreCase)
        && !Model.Job.AzureBatchStatus.Equals("expired", StringComparison.OrdinalIgnoreCase)
        && !Model.Job.AzureBatchStatus.Equals("cancelled", StringComparison.OrdinalIgnoreCase)
        && !Model.Job.AzureBatchStatus.Equals("canceled", StringComparison.OrdinalIgnoreCase);
    var progressPercent = activeBatchProgress
        ? Math.Clamp((int)Math.Round((Model.Job.AzureBatchCompletedRequests.GetValueOrDefault() +
Model.Job.AzureBatchFailedRequests.GetValueOrDefault()) * 100d / Model.Job.AzureBatchTotalRequests!.Value), 0, 100)
        : Model.Job.TotalChunks == 0
            ? Model.Job.Status == JobStatus.Completed ? 100 : 0
            : Math.Clamp((int)Math.Round(Model.Job.CompletedChunks * 100d / Model.Job.TotalChunks), 0, 100);
    var progressLabel = activeBatchProgress
        ? $"Batch: {Model.Job.AzureBatchCompletedRequests.GetValueOrDefault() +
Model.Job.AzureBatchFailedRequests.GetValueOrDefault()} / {Model.Job.AzureBatchTotalRequests} requests"
        : $"{Model.Job.CompletedChunks} / {Model.Job.TotalChunks} chunks";
    var chunkProviders = Model.Job.Chunks
        .Select(chunk => chunk.Provider)
        .Where(provider => !string.IsNullOrWhiteSpace(provider))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(provider => provider, StringComparer.OrdinalIgnoreCase);
    var chunkModels = Model.Job.Chunks
        .Select(chunk => chunk.Model)
        .Where(model => !string.IsNullOrWhiteSpace(model))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(model => model, StringComparer.OrdinalIgnoreCase);
}
<div data-live-job data-live-url="?handler=Live&amp;id=@Model.Job.Id">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="mb-1">Job #@Model.Job.Id</h1>
            <div class="text-muted text-break">@Model.Job.SourcePath</div>
        </div>
        <div class="d-flex gap-2">
            <form data-live-retry-control method="post" asp-page-handler="Retry" asp-route-id="@Model.Job.Id"
                  hidden="@(Model.Job.Status != JobStatus.Failed && Model.Job.Status != JobStatus.Cancelled)">
                <button class="btn btn-warning" type="submit">Retry job</button>
            </form>
            <a class="btn btn-outline-secondary" asp-page="Index">Back to jobs</a>
        </div>
    </div>
    @if (TempData["RetrySuccess"] is string retrySuccess)
    {
        <div class="alert alert-success">@retrySuccess</div>
    }
    @if (TempData["RetryError"] is string retryError)
    {
        <div class="alert alert-danger">@retryError</div>
    }
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Status</div>
                    <div class="fs-5" data-live-status>@Model.Job.Status</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Progress</div>
                    <div class="d-flex justify-content-between fs-6"><span
                        data-live-progress-label>@progressLabel</span><span
                        data-live-progress-percent>@progressPercent%</span></div>
                        <div class="progress mt-2" role="progressbar" aria-valuenow="@progressPercent" aria-valuemin="0"
                             aria-valuemax="100">
                            <div data-live-progress-bar class="progress-bar" style="width: @progressPercent%"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Runtime / cost</div>
                        <div data-live-runtime>@(elapsed?.ToString("c") ?? "Not started")</div>
                        <div data-live-cost>@Model.Job.EstimatedCost.ToString("C")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Tokens</div>
                        <div>Input: <span data-live-input-tokens>@Model.Job.InputTokens.ToString("N0")</span></div>
                        <div>Output: <span data-live-output-tokens>@Model.Job.OutputTokens.ToString("N0")</span></div>
                        <div>Retries: <span data-live-retries>@Model.Job.RetryCount</span></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-lg-5">
                <section class="mb-4">
                    <h2 class="h4">Configuration and batch</h2>
                    <dl class="row">
                        <dt class="col-sm-5">Pipeline</dt>
                        <dd class="col-sm-7">@(Model.Job.Pipeline?.Name ?? "—")</dd>
                        <dt class="col-sm-5">Prompt</dt>
                        <dd class="col-sm-7">@(Model.Job.PromptVersion?.PromptTemplate?.Name ?? "—")
                            @(Model.Job.PromptVersion is null ? "" : $"v{Model.Job.PromptVersion.Version}")</dd>
                            <dt class="col-sm-5">Output</dt>
                            <dd class="col-sm-7 text-break">@(Model.Job.OutputPath ?? "—")</dd>
                            <dt class="col-sm-5">Azure Batch ID</dt>
                            <dd class="col-sm-7 text-break" data-live-batch-id>@(Model.Job.AzureBatchId ?? "—")</dd>
                            <dt class="col-sm-5">Batch status</dt>
                            <dd class="col-sm-7" data-live-batch-status>@(Model.Job.AzureBatchStatus ?? "—")</dd>
                            <dt class="col-sm-5">Batch requests</dt>
                            <dd class="col-sm-7"><span
                                data-live-batch-completed>@(Model.Job.AzureBatchCompletedRequests?.ToString() ?? "—")</span>
                                / <span data-live-batch-total>@(Model.Job.AzureBatchTotalRequests?.ToString() ?? "—")</span>
                                completed; <span data-live-batch-failed>@(Model.Job.AzureBatchFailedRequests?.ToString() ??
                                                                               "0")</span> failed</dd>
                                <dt class="col-sm-5">Created</dt>
                                <dd class="col-sm-7">@Model.Job.CreatedAt.ToLocalTime().ToString("g")</dd>
                                <dt class="col-sm-5">Last activity</dt>
                                <dd class="col-sm-7" data-live-last-activity>@((Model.Job.LastActivityAt ??
                                                                                                Model.Job.UpdatedAt).ToLocalTime().ToString("g"))</dd>
                                </dl>
                                <div data-live-last-error-container class="alert alert-danger"
                                    @((string.IsNullOrWhiteSpace(Model.Job.LastError)) ? "hidden" : null)><strong>Latest error</strong>
                                    <div class="text-break" data-live-last-error>@Model.Job.LastError</div>
                                </div>
                            </section>
                            <section>
                                <h2 class="h4">Timeline</h2>
                                @if (Model.Timeline.Count == 0)
                                {
                                    <p class="text-muted">No timeline events recorded.</p>
                                }
                                else
                                {
                                    <ol class="list-group list-group-numbered">
                                        @foreach (var item in Model.Timeline)
                                        {
                                            <li class="list-group-item">
                                                <div class="fw-semibold">@item.Title</div>
                                                <div class="small text-muted">@item.At.ToLocalTime().ToString("g")</div>
                                                @if (!string.IsNullOrWhiteSpace(item.Details))
                                                {
                                                    <div class="small text-break">@item.Details
                                                    </div>
                                                }
                                            </li>
                                        }
                                    </ol>
                                }
                            </section>
                        </div>
                        <div class="col-lg-7">
                            <h2 class="h4">Chunks and attempts</h2>
                            <div class="row g-2 align-items-end mb-3" data-chunk-filters>
                                <div class="col-md-4">
                                    <label for="ChunkProviderFilter" class="form-label">Provider</label>
                                    <select id="ChunkProviderFilter" class="form-select" data-chunk-provider-filter>
                                        <option value="">All providers</option>
                                        @foreach (var provider in chunkProviders)
                                        {
                                            <option value="@provider">@provider</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="ChunkModelFilter" class="form-label">Model</label>
                                    <select id="ChunkModelFilter" class="form-select" data-chunk-model-filter>
                                        <option value="">All models</option>
                                        @foreach (var modelName in chunkModels)
                                        {
                                            <option value="@modelName">@modelName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check mb-2">
                                        <input id="ChunkErrorsOnly" class="form-check-input" type="checkbox" data-chunk-errors-only>
                                        <label for="ChunkErrorsOnly" class="form-check-label">Only chunks with errors</label>
                                    </div>
                                </div>
                                <div class="col-md-1">
                                    <button type="button" class="btn btn-outline-secondary mb-1" data-chunk-filter-reset>Reset</button>
                                </div>
                                <div class="col-12 small text-muted" data-chunk-filter-count></div>
                            </div>
                            @if (Model.Job.Chunks.Count == 0)
                            {
                                <p class="text-muted">No chunks have been recorded yet.</p>
                            }
                            @foreach (var chunk in Model.Job.Chunks.OrderBy(chunk => chunk.Sequence))
                            {
                                var chunkHasErrors = !string.IsNullOrWhiteSpace(chunk.Error)
                                    || chunk.Status is ChunkStatus.Failed or ChunkStatus.RetryPending
                                    || chunk.Attempts.Any(attempt => !attempt.Success);
                                <div class="card mb-3" data-chunk-card data-chunk-provider="@chunk.Provider" data-chunk-model="@chunk.Model"
                                     data-chunk-has-errors="@(chunkHasErrors ? "true" : "false")">
                                    <div class="card-header d-flex justify-content-between"><span>Chunk @chunk.Sequence · subtitles
                                        @chunk.StartSubtitleIndex–@chunk.EndSubtitleIndex</span><span
                                        class="badge text-bg-secondary">@chunk.Status</span></div>
                                        <div class="card-body">
                                            <div class="small text-muted mb-2">@chunk.Provider / @chunk.Model ·
                                                @chunk.InputTokens.ToString("N0") in / @chunk.OutputTokens.ToString("N0") out ·
                                                @(chunk.LatencyMs?.ToString("N0") ?? "—") ms</div>
                                                @if (!string.IsNullOrWhiteSpace(chunk.Error))
                                                {
                                                    <div class="alert alert-danger py-2 text-break">
                                                        @chunk.Error</div>
                                                    }
                                                    @if (chunk.Attempts.Count == 0)
                                                    {
                                                        <span class="text-muted small">No attempts recorded.</span>
                                                    }
                                                    else
                                                    {
                                                        <div class="table-responsive">
                                                            <table class="table table-sm mb-0">
                                                                <thead>
                                                                    <tr>
                                                                        <th>#</th>
                                                                        <th>Provider / model</th>
                                                                        <th>Result</th>
                                                                        <th>Tokens</th>
                                                                        <th>Latency</th>
                                                                        <th>Cost</th>
                                                                        <th>Error</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var attempt in chunk.Attempts.OrderBy(attempt => attempt.AttemptNumber))
                                                                    {
                                                                        <tr>
                                                                            <td>@attempt.AttemptNumber</td>
                                                                            <td>@attempt.Provider<div class="small text-muted">@attempt.Model</div>
                                                                            </td>
                                                                            <td>@(attempt.Success ? "Success" : "Failed")</td>
                                                                            <td>@attempt.InputTokens.ToString("N0") / @attempt.OutputTokens.ToString("N0")<div
                                                                                class="small text-muted">cached
                                                                                @attempt.CachedTokens.GetValueOrDefault().ToString("N0") · write
                                                                                @attempt.CacheWriteTokens.GetValueOrDefault().ToString("N0")</div>
                                                                            </td>
                                                                            <td>@attempt.LatencyMs.ToString("N0") ms</td>
                                                                            <td>@attempt.EstimatedCost.ToString("C")</td>
                                                                            <td class="text-break">@attempt.ErrorCode @attempt.ErrorMessage</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        <p class="text-muted" data-chunk-no-results hidden>No chunks match these filters.</p>
                                    </div>
                                </div>
                            </div>
