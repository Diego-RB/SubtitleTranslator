@page
@model SubtitleTranslator.Pages.Jobs.IndexModel
@using SubtitleTranslator.Domain.Enums
@{
    ViewData["Title"] = "Translation Jobs";
    var statuses = Enum.GetValues<JobStatus>();
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-1">Translation jobs</h1>
        <div class="text-muted">@Model.JobPage.TotalCount job(s) found</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Index">Dashboard</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <label for="Search" class="visually-hidden">Search source path</label>
        <input id="Search" name="Search" value="@Model.Search" class="form-control" placeholder="Search source path..." />
    </div>
    <div class="col-md-4">
        <label for="Status" class="visually-hidden">Filter by status</label>
        <select id="Status" name="Status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var status in statuses)
            {
                if (Model.Status == status)
                {
                    <option value="@status" selected>@status</option>
                }
                else
                {
                    <option value="@status">@status</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2 d-grid"><button type="submit" class="btn btn-primary">Filter</button></div>
</form>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>Source</th><th>Status</th><th>Progress</th><th>Provider / model</th><th>Duration</th><th>Created</th><th>Cost</th><th></th></tr></thead>
        <tbody>
        @if (Model.JobPage.Jobs.Count == 0)
        {
            <tr><td colspan="8" class="text-center text-muted py-4">No jobs match these filters.</td></tr>
        }
        @foreach (var job in Model.JobPage.Jobs)
        {
            <tr>
                <td class="text-break"><span title="@job.SourcePath">@System.IO.Path.GetFileName(job.SourcePath)</span><div class="small text-muted">@job.SourcePath</div></td>
                <td><span class="badge text-bg-secondary">@job.Status</span>@if (job.FailedChunks > 0) { <div class="small text-danger">@job.FailedChunks failed chunk(s)</div> }</td>
                <td style="min-width: 150px"><div class="d-flex justify-content-between small"><span>@job.CompletedChunks / @job.TotalChunks chunks</span><span>@job.ProgressPercent%</span></div><div class="progress" role="progressbar" aria-valuenow="@job.ProgressPercent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width: @job.ProgressPercent%"></div></div></td>
                <td>@(job.CurrentProvider ?? "—")<div class="small text-muted">@(job.CurrentModel ?? "")</div></td>
                <td class="text-nowrap">@(job.Duration?.ToString(@"hh\:mm\:ss") ?? "—")</td>
                <td class="text-nowrap">@job.CreatedAt.ToLocalTime().ToString("g")</td>
                <td class="text-nowrap">@job.EstimatedCost.ToString("C")</td>
                <td><a class="btn btn-sm btn-outline-primary" asp-page="Details" asp-route-id="@job.Id">Details</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (Model.JobPage.TotalPages > 1)
{
    <nav aria-label="Job pages">
        <ul class="pagination">
            <li class="page-item @(Model.JobPage.Page <= 1 ? "disabled" : "")"><a class="page-link" asp-page="Index" asp-route-pageNumber="@(Model.JobPage.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Previous</a></li>
            <li class="page-item disabled"><span class="page-link">Page @Model.JobPage.Page of @Model.JobPage.TotalPages</span></li>
            <li class="page-item @(Model.JobPage.Page >= Model.JobPage.TotalPages ? "disabled" : "")"><a class="page-link" asp-page="Index" asp-route-pageNumber="@(Model.JobPage.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Next</a></li>
        </ul>
    </nav>
}
