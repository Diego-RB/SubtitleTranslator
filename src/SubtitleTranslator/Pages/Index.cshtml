@page
@model IndexModel
@{
    ViewData["Title"] = "Subtitle Translator Dashboard";
}

<div data-live-dashboard data-live-url="?handler=Live">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="mb-1">Translation dashboard</h1>
            <div class="text-muted">Subtitle translation orchestrator</div>
        </div>
        <span data-live-worker
              class="badge rounded-pill @(Model.Overview.IsWorkerOnline ? "text-bg-success" : "text-bg-danger")">@(Model.Overview.IsWorkerOnline
                ? "WORKER ONLINE" : "WORKER OFFLINE")</span>
        </div>
        <div class="row row-cols-2 row-cols-lg-5 g-3 mb-4">
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="small text-muted">Active jobs</div>
                        <div class="display-6" data-live-counter="activeJobs">@Model.Overview.ActiveJobs</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="small text-muted">Queue</div>
                        <div class="display-6" data-live-counter="queuedJobs">@Model.Overview.QueuedJobs</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="small text-muted">Completed today</div>
                        <div class="display-6" data-live-counter="completedToday">@Model.Overview.CompletedToday</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="small text-muted">Failed jobs</div>
                        <div class="display-6" data-live-counter="failedJobs">@Model.Overview.FailedJobs</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="small text-muted">Stalled jobs</div>
                        <div class="display-6" data-live-counter="stalledJobs">@Model.Overview.StalledJobs</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h4 mb-0">Recent jobs</h2><a asp-page="/Jobs/Index">View all jobs →</a>
        </div>
        <div class="table-responsive mb-4">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Progress</th>
                        <th>Provider / model</th>
                        <th>Cost</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Overview.RecentJobs.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No translation jobs have been discovered.</td>
                        </tr>
                    }
                    @foreach (var job in Model.Overview.RecentJobs)
                    {
                        <tr data-live-dashboard-job="@job.Id">
                            <td class="text-break"><span
                                title="@job.SourcePath">@System.IO.Path.GetFileName(job.SourcePath)</span>
                                <div class="small text-muted">@job.SourcePath</div>
                            </td>
                            <td><span data-live-job-status class="badge text-bg-secondary">@job.Status</span></td>
                            <td style="min-width: 150px">
                                <div class="d-flex justify-content-between small"><span
                                    data-live-job-chunks>@job.ProgressLabel</span><span
                                    data-live-job-percent>@job.ProgressPercent%</span></div>
                                    <div class="progress" role="progressbar" aria-valuenow="@job.ProgressPercent" aria-valuemin="0"
                                         aria-valuemax="100">
                                        <div data-live-job-progress class="progress-bar" style="width: @job.ProgressPercent%"></div>
                                    </div>
                                </td>
                                <td><span data-live-job-provider>@(job.CurrentProvider ?? "—")</span>
                                    <div class="small text-muted" data-live-job-model>@(job.CurrentModel ?? "")</div>
                                </td>
                                <td data-live-job-cost>@job.EstimatedCost.ToString("C")</td>
                                <td><a class="btn btn-sm btn-outline-primary" asp-page="/Jobs/Details"
                                           asp-route-id="@job.Id">Details</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h4 mb-0">Providers</h2><a asp-page="/Providers/Index">Configure providers →</a>
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                    @if (Model.Overview.Providers.Count == 0)
                    {
                        <div class="col">
                            <div class="alert alert-info mb-0">No providers configured yet.</div>
                        </div>
                    }
                    @foreach (var provider in Model.Overview.Providers)
                    {
                        <div class="col">
                            <div class="card h-100">
                                <div class="card-body d-flex justify-content-between gap-3">
                                    <div>
                                        <h3 class="h6 mb-1">@provider.Name</h3>
                                        <div class="small text-muted">@provider.Type · @provider.EnabledModelCount enabled model(s)
                                        </div>
                                        <div class="small mt-2" title="@provider.HealthMessage">@provider.HealthMessage</div>@if
                                        (provider.HealthCheckedAt is not null) {
                                            <div class="small text-muted">Checked
                                                @provider.HealthCheckedAt.Value.ToLocalTime().ToString("g")</div>
                                            }
                                        </div>
                                        <div class="text-end"><span
                                            class="badge @(provider.Enabled ? "text-bg-success" : "text-bg-secondary")">@(provider.Enabled
                                                ? "Enabled" : "Disabled")</span>
                                            <div class="mt-2"><span
                                                class="badge @provider.HealthBadgeClass">@provider.HealthState.ToString().ToUpperInvariant()</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
