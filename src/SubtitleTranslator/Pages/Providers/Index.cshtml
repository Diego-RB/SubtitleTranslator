@page
@model SubtitleTranslator.Pages.Providers.IndexModel
@{
    ViewData["Title"] = "Providers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Providers</h1>
    <a class="btn btn-primary" asp-page="Create">Create provider</a>
</div>
@if (Model.Message is not null) { <div class="alert alert-success">@Model.Message</div> }
@if (Model.ErrorMessage is not null) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
<table class="table table-striped align-middle">
    <thead><tr><th>Name</th><th>Type</th><th>Base URL</th><th>Credential reference</th><th>Enabled</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var provider in Model.Providers)
    {
        <tr>
            <td>@provider.Name</td><td>@provider.Type</td><td>@provider.BaseUrl</td><td>@provider.CredentialId</td>
            <td>@(provider.Enabled ? "Yes" : "No")</td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@provider.Id">Edit</a>
                <form method="post" asp-page-handler="Toggle" asp-route-id="@provider.Id" class="d-inline"><button class="btn btn-sm btn-outline-secondary" type="submit">@(provider.Enabled ? "Disable" : "Enable")</button></form>
                <form method="post" asp-page-handler="Delete" asp-route-id="@provider.Id" class="d-inline" onsubmit="return confirm('Delete this provider?');"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form>
            </td>
        </tr>
    }
    </tbody>
</table>
