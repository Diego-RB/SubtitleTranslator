@page
@model SubtitleTranslator.Pages.Providers.EditModel
@{
    ViewData["Title"] = "Edit provider";
}
<h1>Edit provider</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="Input.Id" type="hidden" />
    <div class="mb-3"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name"
                                                                                        class="form-control" /><span asp-validation-for="Input.Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Input.Type" class="form-label"></label><select asp-for="Input.Type"
                                                                                             asp-items="Html.GetEnumSelectList<SubtitleTranslator.Domain.Enums.ProviderType>()"
                                                                                             class="form-select"></select></div>
            <div class="mb-3"><label asp-for="Input.BaseUrl" class="form-label"></label><input asp-for="Input.BaseUrl"
                                                                                                   class="form-control" />
                <div class="form-text">For Azure OpenAI v1, use the endpoint ending in /openai/v1 (or /openai/v1/responses). The
                    app calls the Chat Completions route.</div><span asp-validation-for="Input.BaseUrl"
                                                                     class="text-danger"></span>
                </div>
                <div class="mb-3"><label asp-for="Input.AuthenticationType" class="form-label"></label><select
                    asp-for="Input.AuthenticationType"
                    asp-items="Html.GetEnumSelectList<SubtitleTranslator.Domain.Enums.AuthenticationType>()"
                    class="form-select"></select></div>
                    <div class="mb-3"><label asp-for="Input.ApiKey" class="form-label">Credential</label><input asp-for="Input.ApiKey"
                                                                                                                    type="password" autocomplete="new-password" class="form-control" />
                        <div class="form-text">@if (Model.HasStoredApiKey) {
                            <text>A credential is saved. Leave blank to keep it, or
                                paste a replacement.</text>
                            } else
                            {

                                <text>Paste an API key to save it encrypted.</text>
                            }
                        </div><span
                        asp-validation-for="Input.ApiKey" class="text-danger"></span>
                    </div>
                    @if (Model.HasStoredApiKey)
                    {
                        <div class="form-check mb-3"><input asp-for="Input.RemoveStoredApiKey" class="form-check-input" /><label
                            asp-for="Input.RemoveStoredApiKey" class="form-check-label">Remove saved credential</label></div>
                        }
                        <details class="mb-3">
                            <summary>Advanced: use an environment variable instead</summary>
                            <div class="mt-2"><label asp-for="Input.CredentialId" class="form-label">Credential ID</label><input
                                asp-for="Input.CredentialId" class="form-control" />
                                <div class="form-text">Enter an environment variable name to switch to legacy environment-based credentials.
                                    Leave blank to keep the current credential source.</div>
                                </div>
                            </details>
                            <div class="mb-3"><label asp-for="Input.ApiVersion" class="form-label"></label><input asp-for="Input.ApiVersion"
                                                                                                                      class="form-control" />
                                <div class="form-text">Optional for Azure OpenAI v1 endpoints; required for legacy Azure deployment endpoints.
                                </div>
                            </div>
                            <div class="form-check mb-3"><input asp-for="Input.Enabled" class="form-check-input" /><label
                                asp-for="Input.Enabled" class="form-check-label"></label></div>
                                <button class="btn btn-primary" type="submit">Save</button>
                                <a class="btn btn-secondary" asp-page="Index">Cancel</a>
                            </form>
                            @section Scripts {
                                <partial name="_ValidationScriptsPartial" />
                            }