@page
@model SubtitleTranslator.Pages.Models.CreateModel
@{ ViewData["Title"] = "Create model"; }
<h1>Create model</h1>
<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Input.ProviderId" class="form-label">Provider</label><select asp-for="Input.ProviderId" class="form-select"><option value="">Select provider</option>@foreach (var provider in Model.Providers) { <option value="@provider.Id" data-configuration-defaults="@Model.GetDefaultConfigurationJson(provider.Type)">@provider.Name</option> }</select><span asp-validation-for="Input.ProviderId" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger"></span></div></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Input.ModelId" class="form-label"></label><input asp-for="Input.ModelId" class="form-control" /><span asp-validation-for="Input.ModelId" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Input.DeploymentName" class="form-label"></label><input asp-for="Input.DeploymentName" class="form-control" /></div></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="Input.ChunkStrategy" class="form-label"></label><select asp-for="Input.ChunkStrategy" asp-items="Html.GetEnumSelectList<SubtitleTranslator.Domain.Enums.ChunkStrategy>()" class="form-select"></select></div><div class="col-md-4 mb-3"><label asp-for="Input.MaxChunkSubtitles" class="form-label"></label><input asp-for="Input.MaxChunkSubtitles" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Input.MaxChunkTokens" class="form-label"></label><input asp-for="Input.MaxChunkTokens" class="form-control" /></div></div>
<div class="row"><div class="col-md-3 mb-3"><label asp-for="Input.Priority" class="form-label"></label><input asp-for="Input.Priority" class="form-control" /></div><div class="col-md-3 mb-3"><label asp-for="Input.ContextWindow" class="form-label">Context window</label><input asp-for="Input.ContextWindow" class="form-control" /></div><div class="col-md-2 mb-3"><label asp-for="Input.MaxOutputTokens" class="form-label">Max output tokens</label><input asp-for="Input.MaxOutputTokens" class="form-control" /></div><div class="col-md-2 mb-3"><label asp-for="Input.Temperature" class="form-label"></label><input asp-for="Input.Temperature" class="form-control" /></div><div class="col-md-2 mb-3"><label asp-for="Input.TopP" class="form-label"></label><input asp-for="Input.TopP" class="form-control" /></div></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="Input.InputCostPer1M" class="form-label">Input cost / 1M tokens</label><input asp-for="Input.InputCostPer1M" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Input.OutputCostPer1M" class="form-label">Output cost / 1M tokens</label><input asp-for="Input.OutputCostPer1M" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Input.CachedInputCostPer1M" class="form-label">Cached input cost / 1M tokens</label><input asp-for="Input.CachedInputCostPer1M" class="form-control" /></div></div>
<div class="row"><div class="col-md-3 form-check mb-3 ms-2"><input asp-for="Input.Enabled" class="form-check-input" /><label asp-for="Input.Enabled" class="form-check-label"></label></div><div class="col-md-3 form-check mb-3"><input asp-for="Input.SupportsTranslation" class="form-check-input" /><label asp-for="Input.SupportsTranslation" class="form-check-label">Supports translation</label></div><div class="col-md-3 form-check mb-3"><input asp-for="Input.SupportsBatch" class="form-check-input" /><label asp-for="Input.SupportsBatch" class="form-check-label">Supports batch</label></div><div class="col-md-3 form-check mb-3"><input asp-for="Input.SupportsStreaming" class="form-check-input" /><label asp-for="Input.SupportsStreaming" class="form-check-label">Supports streaming</label></div></div>
<div class="mb-3"><label asp-for="Input.ConfigurationJson" class="form-label">Configuration JSON</label><textarea asp-for="Input.ConfigurationJson" class="form-control" rows="15"></textarea><div class="form-text">Defaults are prefilled. Selecting a provider loads its default options. You can edit the values; keep valid JSON. maxParallelRequests limits provider requests; pipelineMaxParallelRequests limits concurrent chunks.</div><span asp-validation-for="Input.ConfigurationJson" class="text-danger"></span></div>
<button class="btn btn-primary" type="submit">Save</button> <a class="btn btn-secondary" asp-page="Index">Cancel</a></form>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script>
		(() => {
			const providerSelect = document.getElementById("Input_ProviderId");
			const configurationInput = document.getElementById("Input_ConfigurationJson");
			let lastGeneratedConfiguration = configurationInput.value;

			providerSelect.addEventListener("change", () => {
				const option = providerSelect.selectedOptions[0];
				const defaults = option?.dataset.configurationDefaults;
				if (defaults && configurationInput.value === lastGeneratedConfiguration) {
					configurationInput.value = defaults;
					lastGeneratedConfiguration = defaults;
				}
			});

			configurationInput.addEventListener("input", () => {
				if (configurationInput.value !== lastGeneratedConfiguration) {
					lastGeneratedConfiguration = null;
				}
			});
		})();
	</script>
}
