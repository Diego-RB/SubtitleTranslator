@page
@model SubtitleTranslator.Pages.LoginModel
@{
    ViewData["Title"] = "Dashboard sign in";
}
<div class="row justify-content-center py-5">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-2">Operator sign in</h1>
                <p class="text-muted">Enter the dashboard access token configured by the server administrator.</p>
                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="AccessToken" class="form-label">Access token</label>
                        <input asp-for="AccessToken" type="password" class="form-control" autocomplete="current-password" required autofocus />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </form>
            </div>
        </div>
    </div>
</div>
